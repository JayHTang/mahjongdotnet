@model Mahjong.Models.UserAndRoles
@{
    ViewBag.Title = "用户角色管理";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-left-primary">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="fa-solid fa-user-shield text-primary mr-2"></i>用户角色: <strong>@Model?.UserName</strong></span>
                    <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("EditUser", "Admin", new { UserName = Model?.UserName })">
                        <i class="fa-solid fa-arrow-left mr-1"></i>返回用户
                    </a>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })
                        @Html.HiddenFor(model => model.UserName)

                        <div class="form-row align-items-center mb-3">
                            <div class="col-8">
                                @Html.DropDownList("AddRole", null, new { @class = "custom-select custom-select-sm" })
                            </div>
                            <div class="col-4">
                                <button type="submit" class="btn btn-primary btn-sm btn-block">
                                    <i class="fa-solid fa-plus mr-1"></i>分配角色
                                </button>
                            </div>
                        </div>
                    }

                    <div class="table-responsive mb-0">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>已分配角色</th>
                                    <th class="text-right">操作</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model?.colUserRole != null)
                                {
                                    foreach (var item in Model.colUserRole)
                                    {
                                        var isSelfAdmin = string.Equals(Model.UserName, User.Identity?.Name, StringComparison.OrdinalIgnoreCase)
                                            && string.Equals(item.RoleName, "Administrator", StringComparison.OrdinalIgnoreCase);
                                        <tr>
                                            <td>
                                                @if (item.RoleName == "No Roles Found")
                                                {
                                                    <span class="text-muted">暂无角色</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-info">@item.RoleName</span>
                                                }
                                            </td>
                                            <td class="text-right">
                                                @if (!isSelfAdmin && item.RoleName != "No Roles Found")
                                                {
                                                    <a class="btn btn-outline-danger btn-sm"
                                                       href="@Url.Action("DeleteRole", "Admin", new { UserName = item.UserName, RoleName = item.RoleName })"
                                                       onclick="return confirm('确定要移除该角色吗？');">
                                                        <i class="fa-regular fa-trash-can mr-1"></i>移除
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
