@model Mahjong.Models.ManageLoginsViewModel
@using Microsoft.AspNetCore.Identity
@inject SignInManager<Mahjong.Models.ApplicationUser> SignInManager
@{
    ViewBag.Title = "第三方登录管理";
    var statusMessage = ViewBag.StatusMessage as string;
    var loginProviders = (await SignInManager.GetExternalAuthenticationSchemesAsync()).ToList();
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0"><i class="fa-solid fa-link text-primary mr-2"></i>第三方登录管理</h2>
                <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("Index", "Manage")">
                    <i class="fa-solid fa-arrow-left mr-1"></i>返回账号管理
                </a>
            </div>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="alert alert-info">@statusMessage</div>
            }

            <div class="card">
                <div class="card-body">
                    @if (loginProviders.Count == 0 && Model.CurrentLogins.Count == 0)
                    {
                        <p class="text-muted mb-0">当前系统未配置外部身份认证服务。</p>
                    }
                    else
                    {
                        if (Model.CurrentLogins.Count > 0)
                        {
                            <h5 class="mb-3">已绑定服务</h5>
                            <div class="table-responsive">
                                <table class="table table-hover table-sm mb-0">
                                    <tbody>
                                        @foreach (var account in Model.CurrentLogins)
                                        {
                                            <tr>
                                                <td class="font-weight-bold">@account.LoginProvider</td>
                                                <td class="text-right">
                                                    @if (ViewBag.ShowRemoveButton == true)
                                                    {
                                                        using (Html.BeginForm("RemoveLogin", "Manage"))
                                                        {
                                                            @Html.AntiForgeryToken()
                                                            @Html.Hidden("loginProvider", account.LoginProvider)
                                                            @Html.Hidden("providerKey", account.ProviderKey)
                                                            <button type="submit" class="btn btn-outline-danger btn-sm">移除绑定</button>
                                                        }
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        if (Model.OtherLogins.Count > 0)
                        {
                            <h5 class="mt-3 mb-2">绑定其他服务</h5>
                            using (Html.BeginForm("LinkLogin", "Manage"))
                            {
                                @Html.AntiForgeryToken()
                                <div>
                                    @foreach (var p in Model.OtherLogins)
                                    {
                                        <button type="submit" class="btn btn-outline-primary btn-sm mr-1 mb-1" id="@p.Name" name="provider" value="@p.Name">
                                            @p.DisplayName
                                        </button>
                                    }
                                </div>
                            }
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>
