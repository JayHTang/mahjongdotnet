@model Mahjong.Models.IndexViewModel
@{
    ViewBag.Title = "账号管理";
    var statusMessage = ViewBag.StatusMessage as string;
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="mb-0"><i class="fa-solid fa-gear text-primary mr-2"></i>账号管理</h2>
            </div>

            @if (!string.IsNullOrEmpty(statusMessage))
            {
                <div class="alert alert-success" role="alert">
                    <i class="fa-solid fa-circle-check mr-1"></i>@statusMessage
                </div>
            }

            <div class="card border-left-primary">
                <div class="card-header">
                    安全设置
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <div>
                            <div class="font-weight-bold">登录密码</div>
                            <div class="text-muted small">@(Model.HasPassword ? "已设置本地密码" : "尚未设置本地密码")</div>
                        </div>
                        <div>
                            @if (Model.HasPassword)
                            {
                                <a class="btn btn-outline-primary btn-sm" href="@Url.Action("ChangePassword", "Manage")">
                                    <i class="fa-solid fa-key mr-1"></i>修改密码
                                </a>
                            }
                            else
                            {
                                <a class="btn btn-primary btn-sm" href="@Url.Action("SetPassword", "Manage")">
                                    <i class="fa-solid fa-plus mr-1"></i>设置密码
                                </a>
                            }
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom">
                        <div>
                            <div class="font-weight-bold">第三方登录</div>
                            <div class="text-muted small">已绑定 @Model.Logins.Count 个外部登录方式</div>
                        </div>
                        <div>
                            <a class="btn btn-outline-secondary btn-sm" href="@Url.Action("ManageLogins", "Manage")">
                                管理绑定
                            </a>
                        </div>
                    </div>

                    <div class="pt-2">
                        <div class="font-weight-bold">双重验证 (2FA)</div>
                        <div class="text-muted small mb-0">当前未配置双重验证服务提供商。</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
