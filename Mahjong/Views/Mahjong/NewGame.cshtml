@using Mahjong.Models.Mahjong
@model Game
@{
    ViewBag.Title = "新开一局";
    var players = (List<Player>)ViewData["players"];
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-left-primary">
                <div class="card-header">
                    <i class="fa-solid fa-circle-play text-primary mr-2"></i>新开一局
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("NewGame", "Mahjong", FormMethod.Post, new { id = "new_game_form" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-row">
                            <div class="form-group col-sm-6">
                                <label for="Player1Id" class="font-weight-bold">东</label>
                                <select id="Player1Id" name="Player1Id" class="custom-select">
                                    <option value="" selected="selected">---------</option>
                                </select>
                            </div>
                            <div class="form-group col-sm-6">
                                <label for="Player2Id" class="font-weight-bold">南</label>
                                <select id="Player2Id" name="Player2Id" class="custom-select">
                                    <option value="" selected="selected">---------</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-sm-6">
                                <label for="Player3Id" class="font-weight-bold">西</label>
                                <select id="Player3Id" name="Player3Id" class="custom-select">
                                    <option value="" selected="selected">---------</option>
                                </select>
                            </div>
                            <div class="form-group col-sm-6">
                                <label for="Player4Id" class="font-weight-bold">北</label>
                                <select id="Player4Id" name="Player4Id" class="custom-select">
                                    <option value="" selected="selected">---------</option>
                                </select>
                            </div>
                        </div>

                        <hr class="my-3" />

                        <div class="form-row">
                            <div class="form-group col-sm-6">
                                <label for="HuaValue" class="font-weight-bold">花价 ($)</label>
                                @Html.TextBoxFor(m => m.HuaValue, new { @class = "form-control", type = "number", step = "0.1", min = "0" })
                                @Html.ValidationMessageFor(m => m.HuaValue)
                            </div>
                            <div class="form-group col-sm-6">
                                <label for="LeziValue" class="font-weight-bold">勒子价 ($)</label>
                                @Html.TextBoxFor(m => m.LeziValue, new { @class = "form-control", type = "number", step = "1", min = "0" })
                                @Html.ValidationMessageFor(m => m.LeziValue)
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-3">
                            <button class="btn btn-primary btn-lg" type="submit">
                                <i class="fa-solid fa-dice mr-2"></i>搓起来
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        $(function () {
            var seatIds = ['Player1Id', 'Player2Id', 'Player3Id', 'Player4Id'];
            var seatNames = {
                Player1Id: '坐东',
                Player2Id: '坐南',
                Player3Id: '坐西',
                Player4Id: '坐北'
            };
            var allPlayers = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(players));

            function refreshSeatOptions() {
                var selectedBySeat = {};
                seatIds.forEach(function (id) {
                    selectedBySeat[id] = $('#' + id).val() || '';
                });

                seatIds.forEach(function (id) {
                    var $select = $('#' + id);
                    var currentVal = selectedBySeat[id];
                    $select.empty();
                    $select.append($('<option>', { value: '', text: '---------' }));

                    allPlayers.forEach(function (player) {
                        var pid = String(player.Id);
                        var takenElsewhere = seatIds.some(function (otherId) {
                            return otherId !== id && selectedBySeat[otherId] === pid;
                        });
                        if (!takenElsewhere || pid === currentVal) {
                            $select.append($('<option>', {
                                value: pid,
                                text: player.Name
                            }));
                        }
                    });

                    $select.val(currentVal);
                });
            }

            refreshSeatOptions();

            seatIds.forEach(function (id) {
                $('#' + id).on('change', function () {
                    $(this).next('.validation-alert').remove();
                    refreshSeatOptions();
                });
            });

            $('#new_game_form').on('submit', function (e) {
                $('#new_game_form .validation-alert').remove();
                for (var i = 0; i < seatIds.length; i++) {
                    var id = seatIds[i];
                    var val = $('#' + id).val();
                    if (!val) {
                        $('#' + id).after('<span class="validation-alert">请选择' + seatNames[id] + '的玩家</span>');
                        e.preventDefault();
                    }
                }
            });
        });
    </script>
}
