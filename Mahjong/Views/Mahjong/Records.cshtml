@{
    ViewBag.Title = "输赢纪录";
    var records = ViewBag.records;
    var recordsWinning = ViewBag.recordsWinning;
    var recordsLoss = ViewBag.recordsLoss;
}

<div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <h2 class="mb-0"><i class="fa-solid fa-coins text-warning mr-2"></i>输赢纪录</h2>
</div>

<div class="row">
    <div class="col-xl-5 mb-3">
        <div class="card h-100 border-left-primary">
            <div class="card-header">
                <i class="fa-solid fa-bolt text-primary mr-2"></i>单局纪录
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>牌型</th>
                            <th class="text-right">赢钱</th>
                            <th class="text-right">日期</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in records)
                        {
                            <tr>
                                <td>@Html.Raw(record.Description)</td>
                                <td class="text-right tabular-nums val-positive">@record.Winning.ToString("$#,##0.00")</td>
                                <td class="text-right tabular-nums text-muted">@record.Date</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-3 mb-3">
        <div class="card h-100 border-left-success">
            <div class="card-header">
                <i class="fa-solid fa-arrow-trend-up text-success mr-2"></i>单场赢钱纪录
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>玩家</th>
                            <th class="text-right">赢钱</th>
                            <th class="text-right">日期</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in recordsWinning)
                        {
                            <tr>
                                <td class="font-weight-bold">@record.Player</td>
                                <td class="text-right tabular-nums val-positive">@record.Winning.ToString("$#,##0.00")</td>
                                <td class="text-right tabular-nums text-muted">@record.Date</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-xl-4 mb-3">
        <div class="card h-100 border-left-danger">
            <div class="card-header">
                <i class="fa-solid fa-arrow-trend-down text-danger mr-2"></i>单场输钱纪录
            </div>
            <div class="table-responsive">
                <table class="table table-hover table-sm mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th>玩家</th>
                            <th class="text-right">输钱</th>
                            <th class="text-right">日期</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var record in recordsLoss)
                        {
                            <tr>
                                <td class="font-weight-bold">@record.Player</td>
                                <td class="text-right tabular-nums val-negative">@record.Winning.ToString("$#,##0.00")</td>
                                <td class="text-right tabular-nums text-muted">@record.Date</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
