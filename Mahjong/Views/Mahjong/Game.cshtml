@using Mahjong.Models.Mahjong
@using System.Text.Json
@model Result
@{
    var playerBook = (Dictionary<int, string>)ViewData["playerBook"];
    var players = (List<Player>)ViewData["players"];
    var balanceSheet = (Dictionary<int, Decimal>)ViewData["balanceSheet"];
    var gameLogs = (List<GameLog>)ViewData["gameLogs"];
    var hands = (List<Hand>)ViewData["hands"];
    var huangfanCount = (int)ViewData["huangfanCount"];
    var finished = (bool)ViewData["finished"];
    var date = ViewData["gameDate"];
    var gameId = (int)ViewData["gameId"];
    var canEdit = User.IsInRole("Administrator") || User.IsInRole("Mahjong");
    var hcSeriesJson = JsonSerializer.Serialize(ViewData["hc_series"] ?? new List<GameSplineSeriesDto>());

    if (canEdit)
    {
        ViewBag.Title = "Results";
    }
    else
    {
        ViewBag.Title = "麻将局 " + date;
    }

    string fieldLock = finished ? "return false;" : "";

    string GetValueClass(decimal val)
    {
        if (val > 0) return "val-positive";
        if (val < 0) return "val-negative";
        return "val-neutral";
    }
}

<div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <div class="d-flex align-items-center flex-wrap">
        <h2 class="mb-0 mr-3">
            <i class="fa-solid fa-dice text-primary mr-2"></i>麻将局 <span class="text-muted font-weight-normal h5 mb-0">@date</span>
        </h2>
        @if (finished)
        {
            <span class="badge badge-secondary badge-pill"><i class="fa-solid fa-lock mr-1"></i>已结束</span>
        }
        else
        {
            <span class="badge badge-success badge-pill"><i class="fa-solid fa-circle-play mr-1"></i>进行中</span>
        }
        @if (huangfanCount > 0)
        {
            <span class="badge badge-warning badge-pill ml-2">荒番剩 <span id="huangfanBadgeCount">@huangfanCount</span></span>
        }
    </div>
    <div class="mt-2 mt-sm-0">
        <a class="btn btn-outline-primary btn-sm" href="@Url.Action("Stats", "Mahjong", new { id = gameId })">
            <i class="fa-solid fa-chart-pie mr-1"></i>本场统计
        </a>
        <a class="btn btn-outline-secondary btn-sm ml-1" href="@Url.Action("History", "Mahjong")">
            <i class="fa-solid fa-arrow-left mr-1"></i>返回历史战绩
        </a>
    </div>
</div>

<div class="row">
    @if (canEdit)
    {
        <div class="col-lg-3 mb-3">
            <div class="card border-left-primary">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="fa-solid fa-pen-to-square text-primary mr-2"></i>本局结果</span>
                    <span class="badge badge-light">荒番: <span id="huangfanCount">@huangfanCount</span></span>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("Game", "Mahjong", new { gameId = gameId }, FormMethod.Post, antiforgery: null, htmlAttributes: new { id = "result_form" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="form-group mb-3">
                            <label class="font-weight-bold small text-secondary d-block mb-1">骰子</label>
                            <a href="#" class="two-dice" data-toggle="modal" data-target="#dice-modal" title="点击选择骰子">
                                <img src="~/Content/images/dice-00.png" class="dice" id="dice1" alt="骰子 1" />
                                <img src="~/Content/images/dice-00.png" class="dice" id="dice2" alt="骰子 2" />
                            </a>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-8 mb-2">
                                <label for="WinnerId" class="font-weight-bold small text-secondary mb-1">赢家</label>
                                <select id="WinnerId" name="WinnerId" class="custom-select custom-select-sm">
                                    <option value="" selected="selected">--------- (荒庄)</option>
                                    <option value="@gameLogs.First().Player1Id">@playerBook[gameLogs.First().Player1Id]</option>
                                    <option value="@gameLogs.First().Player2Id">@playerBook[gameLogs.First().Player2Id]</option>
                                    <option value="@gameLogs.First().Player3Id">@playerBook[gameLogs.First().Player3Id]</option>
                                    <option value="@gameLogs.First().Player4Id">@playerBook[gameLogs.First().Player4Id]</option>
                                </select>
                            </div>
                            <div class="form-group col-4 mb-2">
                                <label for="HuaCount" class="font-weight-bold small text-secondary mb-1">花</label>
                                @Html.TextBoxFor(m => m.HuaCount, new { @class = "form-control form-control-sm", Type = "Number", min = "0" })
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label for="HandId" class="font-weight-bold small text-secondary mb-1">牌型</label>
                            <select id="HandId" name="HandId" class="custom-select custom-select-sm">
                                <option value="" selected="selected">---------</option>
                                @foreach (var hand in hands)
                                {
                                    <option value="@hand.Id">@hand.Name</option>
                                }
                            </select>
                        </div>

                        <div class="mahjong-check-grid mb-3">
                            <label class="mahjong-check-item">
                                @Html.CheckBoxFor(m => m.Zimo) <span>自摸</span>
                            </label>
                            <label class="mahjong-check-item">
                                @Html.CheckBoxFor(m => m.Menqing) <span>门清</span>
                            </label>
                            <label class="mahjong-check-item">
                                @Html.CheckBoxFor(m => m.Lezi) <span>大吊车</span>
                            </label>
                            <label class="mahjong-check-item">
                                @Html.CheckBoxFor(m => m.Qianggang) <span>抢杠</span>
                            </label>
                            <label class="mahjong-check-item">
                                @Html.CheckBoxFor(m => m.Gangkai) <span>杠开</span>
                            </label>
                            <label class="mahjong-check-item">
                                @Html.CheckBoxFor(m => m.Laoyue) <span>海底捞月</span>
                            </label>
                            <label class="mahjong-check-item" style="grid-column: span 2;">
                                @if (huangfanCount > 0)
                                {
                                    @Html.CheckBox("Huangfan", new { @checked = true, @onclick = "return false;" })
                                }
                                else
                                {
                                    @Html.CheckBox("Huangfan", new { @onclick = "return false;" })
                                }
                                <span>荒番 (剩 <strong id="huangfanInlineCount">@huangfanCount</strong>)</span>
                            </label>
                        </div>

                        <div class="form-group mb-2">
                            <label for="DianpaoId" class="font-weight-bold small text-secondary mb-1">点炮</label>
                            <select id="DianpaoId" name="DianpaoId" class="custom-select custom-select-sm">
                                <option value="" selected="selected">---------</option>
                                <option value="@gameLogs.First().Player1Id">@playerBook[gameLogs.First().Player1Id]</option>
                                <option value="@gameLogs.First().Player2Id">@playerBook[gameLogs.First().Player2Id]</option>
                                <option value="@gameLogs.First().Player3Id">@playerBook[gameLogs.First().Player3Id]</option>
                                <option value="@gameLogs.First().Player4Id">@playerBook[gameLogs.First().Player4Id]</option>
                            </select>
                        </div>

                        <div class="form-group mb-3">
                            <label for="ChengbaoId" class="font-weight-bold small text-secondary mb-1">承包</label>
                            <select id="ChengbaoId" name="ChengbaoId" class="custom-select custom-select-sm">
                                <option value="" selected="selected">---------</option>
                                <option value="@gameLogs.First().Player1Id">@playerBook[gameLogs.First().Player1Id]</option>
                                <option value="@gameLogs.First().Player2Id">@playerBook[gameLogs.First().Player2Id]</option>
                                <option value="@gameLogs.First().Player3Id">@playerBook[gameLogs.First().Player3Id]</option>
                                <option value="@gameLogs.First().Player4Id">@playerBook[gameLogs.First().Player4Id]</option>
                            </select>
                        </div>

                        @Html.HiddenFor(m => m.Dice)

                        <button class="btn btn-primary btn-block mb-3 @(finished ? "disabled" : "")" type="submit" onclick="@fieldLock" @(finished ? "disabled" : "")>
                            <i class="fa-solid fa-check mr-1"></i>胡 / 记录本局
                        </button>

                        <div class="d-flex justify-content-between mb-2">
                            <a class="btn btn-outline-secondary btn-sm flex-fill mr-1 @(finished ? "disabled" : "")" href="@Url.Action("Huangfan", "Mahjong", new { gameId = gameId, count = 1 })" role="button" onclick="@fieldLock">+1 荒番</a>
                            <a class="btn btn-outline-secondary btn-sm flex-fill mr-1 @(finished ? "disabled" : "")" href="@Url.Action("Huangfan", "Mahjong", new { gameId = gameId, count = 2 })" role="button" onclick="@fieldLock">+2 荒番</a>
                            <a class="btn btn-outline-secondary btn-sm flex-fill @(finished ? "disabled" : "")" href="@Url.Action("Huangfan", "Mahjong", new { gameId = gameId, count = -1 })" role="button" onclick="@fieldLock">-1 荒番</a>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a class="btn btn-outline-primary btn-sm flex-fill mr-1" href="@Url.Action("Stats", "Mahjong", new { id = gameId })" role="button">
                                <i class="fa-solid fa-chart-simple mr-1"></i>数据统计
                            </a>
                            <a class="btn btn-outline-danger btn-sm flex-fill @(finished ? "disabled" : "")" href="@Url.Action("Finish", "Mahjong", new { gameId = gameId })" role="button" onclick="@fieldLock">
                                <i class="fa-solid fa-flag-checkered mr-1"></i>结束牌局
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="@(canEdit ? "col-lg-9" : "col-12")">
        <div class="row">
            <div class="col-lg-4 col-xl-3 mb-3">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="fa-solid fa-scale-balanced text-primary mr-2"></i>输赢</span>
                        @if (canEdit)
                        {
                            <a class="btn btn-outline-secondary btn-sm @(finished ? "disabled" : "")" href="@Url.Action("Sub", "Mahjong", new { gameId = gameId })" role="button" onclick="@fieldLock">
                                <i class="fa-solid fa-people-arrows mr-1"></i>换人
                            </a>
                        }
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover table-sm mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>玩家</th>
                                    <th class="text-right">累计输赢</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var player in players)
                                {
                                    var bal = balanceSheet[player.Id];
                                    <tr>
                                        <td class="font-weight-bold">@player.Name</td>
                                        <td class="text-right tabular-nums @GetValueClass(bal)">@bal.ToString("$#,##0.00")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-lg-8 col-xl-9 mb-3">
                <div class="card h-100">
                    <div class="card-header">
                        <i class="fa-solid fa-chart-line text-primary mr-2"></i>趋势图
                    </div>
                    <div class="card-body p-2">
                        <div id="chart" style="min-height: 320px; width: 100%;"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="fa-solid fa-list-ol text-primary mr-2"></i>对局详情</span>
                <span class="text-muted small">共 @gameLogs.Sum(g => g.Results.Count) 盘</span>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-sm mb-0" id="details">
                    @for (int i = 0; i < gameLogs.Count; i++)
                    {
                        GameLog gameLog = gameLogs[i];
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center">局数</th>
                                <th class="text-right">@playerBook[gameLog.Player1Id]</th>
                                <th class="text-right">@playerBook[gameLog.Player2Id]</th>
                                <th class="text-right">@playerBook[gameLog.Player3Id]</th>
                                <th class="text-right">@playerBook[gameLog.Player4Id]</th>
                                <th colspan="2">牌型</th>
                                <th class="text-center">骰子</th>
                            </tr>
                        </thead>
                        for (int j = gameLog.Results.Count - 1; j >= 0; j--)
                        {
                            var roundResult = gameLog.Results[j];
                            <tbody class="record-group">
                                <tr>
                                    <td rowspan="@roundResult.RoundDetails.Count" class="text-center font-weight-bold text-muted tabular-nums">@(j + 1)</td>
                                    <td rowspan="@roundResult.RoundDetails.Count" class="text-right tabular-nums @GetValueClass(roundResult.Round.Delta1)">@roundResult.Round.Delta1.ToString("#,##0.00")</td>
                                    <td rowspan="@roundResult.RoundDetails.Count" class="text-right tabular-nums @GetValueClass(roundResult.Round.Delta2)">@roundResult.Round.Delta2.ToString("#,##0.00")</td>
                                    <td rowspan="@roundResult.RoundDetails.Count" class="text-right tabular-nums @GetValueClass(roundResult.Round.Delta3)">@roundResult.Round.Delta3.ToString("#,##0.00")</td>
                                    <td rowspan="@roundResult.RoundDetails.Count" class="text-right tabular-nums @GetValueClass(roundResult.Round.Delta4)">@roundResult.Round.Delta4.ToString("#,##0.00")</td>
                                    @if (roundResult.RoundDetails.Count > 1)
                                    {
                                        <td rowspan="@roundResult.RoundDetails.Count" style="width:1%;white-space:nowrap;border-right:none;text-align:center">
                                            <span class="badge badge-info">@roundResult.Description</span>
                                        </td>
                                        <td style="border-left:none;border-bottom:none">
                                            @roundResult.RoundDetails[0].Description
                                            @if (canEdit)
                                            {
                                                <a class="modal-edit-round ml-1 text-primary"
                                                   href="#"
                                                   title="编辑此盘记录"
                                                   data-toggle="modal"
                                                   data-target="#editRound"
                                                   data-description="@roundResult.RoundDetails[0].Description"
                                                   data-roundid="@roundResult.Round.Id"
                                                   data-rounddetailid="@roundResult.RoundDetails[0].Id"
                                                   data-winnerid="@roundResult.RoundDetails[0].WinnerId"
                                                   data-huacount="@roundResult.RoundDetails[0].HuaCount"
                                                   data-handid="@roundResult.RoundDetails[0].HandId"
                                                   data-lezi="@roundResult.RoundDetails[0].Lezi.ToString()"
                                                   data-menqing="@roundResult.RoundDetails[0].Menqing.ToString()"
                                                   data-zimo="@roundResult.RoundDetails[0].Zimo.ToString()"
                                                   data-dianpaoid="@roundResult.RoundDetails[0].DianpaoId"
                                                   data-qianggang="@roundResult.RoundDetails[0].Qianggang.ToString()"
                                                   data-huangfan="@roundResult.RoundDetails[0].Huangfan.ToString()"
                                                   data-gangkai="@roundResult.RoundDetails[0].Gangkai.ToString()"
                                                   data-laoyue="@roundResult.RoundDetails[0].Laoyue.ToString()"
                                                   data-chengbaoid="@roundResult.RoundDetails[0].ChengbaoId">
                                                    <i class="fa-regular fa-pen-to-square"></i>
                                                </a>
                                            }
                                        </td>
                                    }
                                    else
                                    {
                                        <td colspan="2">
                                            @if (!string.IsNullOrEmpty(roundResult.Description))
                                            {
                                                <span class="badge badge-light mr-1">@roundResult.Description</span>
                                            }
                                            @roundResult.RoundDetails[0].Description
                                            @if (canEdit)
                                            {
                                                <a class="modal-edit-round ml-1 text-primary"
                                                   href="#"
                                                   title="编辑此盘记录"
                                                   data-toggle="modal"
                                                   data-target="#editRound"
                                                   data-description="@roundResult.RoundDetails[0].Description"
                                                   data-roundid="@roundResult.Round.Id"
                                                   data-rounddetailid="@roundResult.RoundDetails[0].Id"
                                                   data-winnerid="@roundResult.RoundDetails[0].WinnerId"
                                                   data-huacount="@roundResult.RoundDetails[0].HuaCount"
                                                   data-handid="@roundResult.RoundDetails[0].HandId"
                                                   data-lezi="@roundResult.RoundDetails[0].Lezi.ToString()"
                                                   data-menqing="@roundResult.RoundDetails[0].Menqing.ToString()"
                                                   data-zimo="@roundResult.RoundDetails[0].Zimo.ToString()"
                                                   data-dianpaoid="@roundResult.RoundDetails[0].DianpaoId"
                                                   data-qianggang="@roundResult.RoundDetails[0].Qianggang.ToString()"
                                                   data-huangfan="@roundResult.RoundDetails[0].Huangfan.ToString()"
                                                   data-gangkai="@roundResult.RoundDetails[0].Gangkai.ToString()"
                                                   data-laoyue="@roundResult.RoundDetails[0].Laoyue.ToString()"
                                                   data-chengbaoid="@roundResult.RoundDetails[0].ChengbaoId">
                                                    <i class="fa-regular fa-pen-to-square"></i>
                                                </a>
                                            }
                                        </td>
                                    }
                                    <td rowspan="@roundResult.RoundDetails.Count" class="text-center text-nowrap">@Html.Raw(roundResult.Dice)</td>
                                </tr>
                                @for (int k = 1; k < roundResult.RoundDetails.Count; k++)
                                {
                                    <tr>
                                        <td style="border-left:none;border-top:none">
                                            @roundResult.RoundDetails[k].Description
                                            @if (canEdit)
                                            {
                                                <a class="modal-edit-round ml-1 text-primary"
                                                   href="#"
                                                   title="编辑此盘记录"
                                                   data-toggle="modal"
                                                   data-target="#editRound"
                                                   data-description="@roundResult.RoundDetails[k].Description"
                                                   data-roundid="@roundResult.Round.Id"
                                                   data-rounddetailid="@roundResult.RoundDetails[k].Id"
                                                   data-winnerid="@roundResult.RoundDetails[k].WinnerId"
                                                   data-huacount="@roundResult.RoundDetails[k].HuaCount"
                                                   data-handid="@roundResult.RoundDetails[k].HandId"
                                                   data-lezi="@roundResult.RoundDetails[k].Lezi.ToString()"
                                                   data-menqing="@roundResult.RoundDetails[k].Menqing.ToString()"
                                                   data-zimo="@roundResult.RoundDetails[k].Zimo.ToString()"
                                                   data-dianpaoid="@roundResult.RoundDetails[k].DianpaoId"
                                                   data-qianggang="@roundResult.RoundDetails[k].Qianggang.ToString()"
                                                   data-huangfan="@roundResult.RoundDetails[k].Huangfan.ToString()"
                                                   data-gangkai="@roundResult.RoundDetails[k].Gangkai.ToString()"
                                                   data-laoyue="@roundResult.RoundDetails[k].Laoyue.ToString()"
                                                   data-chengbaoid="@roundResult.RoundDetails[k].ChengbaoId">
                                                    <i class="fa-regular fa-pen-to-square"></i>
                                                </a>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        }
                    }
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Edit Round Modal -->
<div class="modal fade" id="editRound" tabindex="-1" role="dialog" aria-labelledby="editRoundModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">编辑对局</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            @{
                var baseEditUrl = Url.Action("Edit", "Mahjong", new { gameId = gameId });
            }
            <form action="@baseEditUrl" data-base-action="@baseEditUrl" method="post" id="edit_form">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="form-row">
                        <div class="form-group col-8 mb-2">
                            <label class="font-weight-bold small text-secondary mb-1">赢家</label>
                            <select id="WinnerId" name="WinnerId" class="custom-select custom-select-sm">
                                <option value="" selected="selected">--------- (荒庄)</option>
                                <option value="@gameLogs.First().Player1Id">@playerBook[gameLogs.First().Player1Id]</option>
                                <option value="@gameLogs.First().Player2Id">@playerBook[gameLogs.First().Player2Id]</option>
                                <option value="@gameLogs.First().Player3Id">@playerBook[gameLogs.First().Player3Id]</option>
                                <option value="@gameLogs.First().Player4Id">@playerBook[gameLogs.First().Player4Id]</option>
                            </select>
                        </div>
                        <div class="form-group col-4 mb-2">
                            <label class="font-weight-bold small text-secondary mb-1">花</label>
                            @Html.TextBoxFor(m => m.HuaCount, new { @class = "form-control form-control-sm", Type = "Number", min = "0" })
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label class="font-weight-bold small text-secondary mb-1">牌型</label>
                        <select id="HandId" name="HandId" class="custom-select custom-select-sm">
                            <option value="" selected="selected">---------</option>
                            @foreach (var hand in hands)
                            {
                                <option value="@hand.Id">@hand.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mahjong-check-grid mb-3">
                        <label class="mahjong-check-item">
                            @Html.CheckBoxFor(m => m.Zimo) <span>自摸</span>
                        </label>
                        <label class="mahjong-check-item">
                            @Html.CheckBoxFor(m => m.Menqing) <span>门清</span>
                        </label>
                        <label class="mahjong-check-item">
                            @Html.CheckBoxFor(m => m.Lezi) <span>大吊车</span>
                        </label>
                        <label class="mahjong-check-item">
                            @Html.CheckBoxFor(m => m.Qianggang) <span>抢杠</span>
                        </label>
                        <label class="mahjong-check-item">
                            @Html.CheckBoxFor(m => m.Gangkai) <span>杠开</span>
                        </label>
                        <label class="mahjong-check-item">
                            @Html.CheckBoxFor(m => m.Laoyue) <span>海底捞月</span>
                        </label>
                        <label class="mahjong-check-item" style="grid-column: span 2;">
                            @Html.CheckBoxFor(m => m.Huangfan) <span>荒番</span>
                        </label>
                    </div>

                    <div class="form-group mb-2">
                        <label class="font-weight-bold small text-secondary mb-1">点炮</label>
                        <select id="DianpaoId" name="DianpaoId" class="custom-select custom-select-sm">
                            <option value="">---------</option>
                            <option value="@gameLogs.First().Player1Id">@playerBook[gameLogs.First().Player1Id]</option>
                            <option value="@gameLogs.First().Player2Id">@playerBook[gameLogs.First().Player2Id]</option>
                            <option value="@gameLogs.First().Player3Id">@playerBook[gameLogs.First().Player3Id]</option>
                            <option value="@gameLogs.First().Player4Id">@playerBook[gameLogs.First().Player4Id]</option>
                        </select>
                    </div>

                    <div class="form-group mb-0">
                        <label class="font-weight-bold small text-secondary mb-1">承包</label>
                        <select id="ChengbaoId" name="ChengbaoId" class="custom-select custom-select-sm">
                            <option value="" selected="selected">---------</option>
                            <option value="@gameLogs.First().Player1Id">@playerBook[gameLogs.First().Player1Id]</option>
                            <option value="@gameLogs.First().Player2Id">@playerBook[gameLogs.First().Player2Id]</option>
                            <option value="@gameLogs.First().Player3Id">@playerBook[gameLogs.First().Player3Id]</option>
                            <option value="@gameLogs.First().Player4Id">@playerBook[gameLogs.First().Player4Id]</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">关闭</button>
                    <button type="submit" class="btn btn-primary"><i class="fa-solid fa-check mr-1"></i>提交</button>
                </div>
            </form>
        </div>
    </div>
</div>

