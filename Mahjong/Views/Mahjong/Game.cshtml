<input type="hidden" id="addedHuangfan" name="addedHuangfan" value="0" />

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/highcharts@latest/highcharts.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/highcharts@latest/modules/series-label.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/highcharts@latest/modules/exporting.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/highcharts@latest/modules/export-data.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/highcharts@latest/modules/accessibility.js"></script>
    <script src="~/Content/js/highcharts-helpers.js" asp-append-version="true"></script>
    <script src="~/Scripts/mahjong-game-validator.js" asp-append-version="true"></script>
    <script>
        $(function () {
            var hcSeries = parseChartData(@Html.Raw(hcSeriesJson));
            registerThemedChart(Highcharts.chart('chart', Highcharts.merge(getMahjongChartTheme(), {
                chart: {
                    type: 'spline',
                    zoomType: 'x'
                },
                title: {
                    text: ''
                },
                xAxis: {
                    tickInterval: 1
                },
                yAxis: {
                    title: {
                        text: '输赢'
                    }
                },
                tooltip: {
                    shared: true,
                    headerFormat: '<span style="font-size: 14px"><b>第{point.key}局</b></span><br/>',
                    pointFormat: '{series.name}: ${point.y:,.2f}<br/>'
                },
                plotOptions: {
                    spline: {
                        marker: {
                            enabled: false
                        }
                    }
                },
                series: hcSeries,
                exporting: {
                    enabled: true
                },
                credits: {
                    enabled: false
                }
            })));
        });

        $(document).on("click", ".modal-edit-round", function () {
            var $link = $(this);
            var description = "编辑 " + ($link.data("description") || "荒庄");
            $("#editRound #modalTitle").text(description);

            var $editForm = $("#editRound #edit_form");
            $editForm.find(".validation-alert").remove();
            var baseAction = $editForm.attr("data-base-action");
            var roundId = $link.data("roundid");
            var roundDetailId = $link.data("rounddetailid");
            var sep = baseAction.indexOf("?") >= 0 ? "&" : "?";
            $editForm.attr("action", baseAction + sep + "roundId=" + encodeURIComponent(roundId) + "&roundDetailId=" + encodeURIComponent(roundDetailId));

            window.trackEvent("round_edit_open", {
                game_id: @gameId,
                round_id: roundId,
                round_detail_id: roundDetailId
            });

            var winnerId = $link.data("winnerid");
            if (parseInt(winnerId, 10) > 0) {
                $("#editRound #WinnerId").val(String(winnerId));
            } else {
                $("#editRound #WinnerId").val("");
            }

            var huaCount = $link.data("huacount");
            if (parseInt(huaCount, 10) >= 0) {
                $("#editRound #HuaCount").val(huaCount);
            } else {
                $("#editRound #HuaCount").val("");
            }

            var handId = $link.data("handid");
            if (parseInt(winnerId, 10) > 0 && parseInt(handId, 10) > 0) {
                $("#editRound #HandId").val(String(handId));
            } else {
                $("#editRound #HandId").val("");
            }

            $("#editRound #Lezi").prop("checked", window.parseBool($link.data("lezi")));
            $("#editRound #Menqing").prop("checked", window.parseBool($link.data("menqing")));
            $("#editRound #Zimo").prop("checked", window.parseBool($link.data("zimo")));

            var dianpaoId = $link.data("dianpaoid");
            if (parseInt(dianpaoId, 10) > 0) {
                $("#editRound #DianpaoId").val(String(dianpaoId));
            } else {
                $("#editRound #DianpaoId").val("");
            }

            $("#editRound #Qianggang").prop("checked", window.parseBool($link.data("qianggang")));
            $("#editRound #Huangfan").prop("checked", window.parseBool($link.data("huangfan")));
            $("#editRound #Gangkai").prop("checked", window.parseBool($link.data("gangkai")));
            $("#editRound #Laoyue").prop("checked", window.parseBool($link.data("laoyue")));

            var chengbaoId = $link.data("chengbaoid");
            if (parseInt(chengbaoId, 10) > 0) {
                $("#editRound #ChengbaoId").val(String(chengbaoId));
            } else {
                $("#editRound #ChengbaoId").val("");
            }
        });

        $(window).on("load", function () {
            if (@(!finished ? "true" : "false") && @(canEdit ? "true" : "false")) {
                $("#dice-modal").modal("show");
            }
        });

        $("#dice-table .two-dice").on("click", function (e) {
            e.preventDefault();
            if (@(!finished ? "true" : "false")) {
                var dice = $(this).attr("id");
                $("#result_form #Dice").val(dice);
                window.trackEvent("dice_roll_select", { game_id: @gameId, dice: dice });

                var diceId = parseInt(dice, 10);
                if (!isNaN(diceId)) {
                    var d1 = Math.floor(diceId / 10);
                    var d2 = diceId % 10;
                    if (d1 >= 1 && d1 <= 6 && d2 >= 1 && d2 <= 6) {
                        $("#dice1").attr("src", "/Content/images/dice-0" + d1 + ".png");
                        $("#dice2").attr("src", "/Content/images/dice-0" + d2 + ".png");
                        var addHuangfan = 0;
                        if ((d1 === 1 && d2 === 1) || (d1 === 4 && d2 === 4)) {
                            addHuangfan = 2;
                        } else if ((d1 === 1 && d2 === 4) || d1 === d2) {
                            addHuangfan = 1;
                        }
                        var addedHuangfan = parseInt($("#addedHuangfan").val(), 10) || 0;
                        $("#addedHuangfan").val(addHuangfan);
                        addHuangfan -= addedHuangfan;
                        if (addHuangfan !== 0) {
                            $.ajax({
                                url: "@Url.Action("Huangfan", "Mahjong")",
                                data: { gameId: @gameId, count: addHuangfan }
                            }).done(function () {
                                var currentCount = parseInt($("#huangfanCount").text(), 10) || 0;
                                currentCount += addHuangfan;
                                $("#huangfanCount").text(currentCount);
                                $("#huangfanInlineCount").text(currentCount);
                                $("#huangfanBadgeCount").text(currentCount);
                                $("#result_form #Huangfan").prop("checked", currentCount > 0);
                            });
                        }
                    }
                }
            }
            $("#dice-modal").modal("hide");
        });
    </script>
}
