<!-- 牌型数据 -->
<div class="card mb-4">
    <div class="card-header">
        <i class="fa-solid fa-layer-group text-primary mr-2"></i>牌型数据
    </div>
    <div class="card-body p-2">
        <table id="handTable" class="table table-bordered table-hover table-sm stats-table">
            <thead class="thead-light">
                <tr>
                    <th rowspan="2" class="nowrap-header border-right-group">玩家</th>
                    @foreach (var hand in hands)
                    {
                        <th colspan="3" class="nowrap-header border-right-group">@hand.Name</th>
                    }
                </tr>
                <tr>
                    @foreach (var hand in hands)
                    {
                        <th>#</th>
                        <th>%</th>
                        <th class="border-right-group">$/#</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (Player player in realPlayers)
                {
                    var stat = statBook[player.Id];
                    <tr class="text-right tabular-nums">
                        <td class="text-left font-weight-bold border-right-group">@player.Name</td>
                        @foreach (Hand hand in hands)
                        {
                            var hs = stat.Hands[hand.Id];
                            <td>@hs.Count</td>
                            <td>@FmtPct(hs.Count, stat.Wins)</td>
                            <td class="border-right-group">@FmtAvg(hs.Money, hs.Count)</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- 座位数据 & 资金流向 -->
<div class="row">
    <div class="@(ViewBag.gameId == 0 ? "col-xl-7" : "col-12") mb-4">
        <div class="card h-100">
            <div class="card-header">
                <i class="fa-solid fa-compass text-primary mr-2"></i>座位数据 <span class="text-muted small font-weight-normal ml-1">(下家 \ 上家)</span>
            </div>
            <div class="table-responsive">
                <table class="table table-bordered table-hover table-sm mb-0 stats-table">
                    <thead class="thead-light">
                        <tr>
                            <th>下家 \ <b>上家</b></th>
                            @foreach (Player player in realPlayers)
                            {
                                <th class="text-center">@player.Name</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (Player player in realPlayers)
                        {
                            var stat = statBook[player.Id];
                            <tr>
                                <td class="font-weight-bold">@player.Name</td>
                                @foreach (Player upPlayer in realPlayers)
                                {
                                    if (upPlayer.Id == player.Id)
                                    {
                                        <td class="text-center text-muted">\</td>
                                    }
                                    else if (stat.UpMoneyWon.ContainsKey(upPlayer.Id) && stat.UpMoneyWonCount.ContainsKey(upPlayer.Id) && stat.UpMoneyWonCount[upPlayer.Id] > 0)
                                    {
                                        var sum = stat.UpMoneyWon[upPlayer.Id];
                                        var avg = sum / stat.UpMoneyWonCount[upPlayer.Id];
                                        <td class="text-center tabular-nums @GetValueClass(sum)">
                                            @sum.ToString("$#,##0.00") <span class="text-muted small">(@avg.ToString("$#,##0.00"))</span>
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="text-center text-muted">N/A</td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (ViewBag.gameId == 0)
    {
        <div class="col-xl-5 mb-4">
            <div class="card h-100">
                <div class="card-header">
                    <i class="fa-solid fa-arrows-spin text-primary mr-2"></i>资金流向
                </div>
                <div class="card-body p-2 d-flex align-items-center justify-content-center">
                    <div id="chart" style="min-height: 380px; width: 100%;"></div>
                </div>
            </div>
        </div>
    }
</div>

@if (ViewBag.gameId == 0)
{
