@using Mahjong.Models.Mahjong
@using System.Text.Json
@{
    ViewBag.Title = "数据";
    var players = (List<Player>)ViewData["players"];
    var realPlayers = (List<Player>)ViewData["realPlayers"];
    var hands = (List<Hand>)ViewData["hands"];
    var statBook = (Dictionary<int, Stat>)ViewData["statBook"];
    var diceRolls = (List<DiceRoll>)ViewData["diceRolls"];
    var diceRollers = (List<Player>)ViewData["diceRollers"];
    var playerTotalRolls = (Dictionary<int, int>)ViewData["playerTotalRolls"];
    var cashFlowDataJson = JsonSerializer.Serialize(ViewData["cashFlowData"] ?? new List<DependencyWheelPointDto>());

    string FmtMoney(decimal amount)
    {
        return ((double)amount).ToString("$#,##0.00");
    }

    string FmtAvg(decimal numerator, int denominator)
    {
        if (denominator == 0) return "$0.00";
        return ((double)numerator / denominator).ToString("$#,##0.00");
    }

    string FmtPct(double numerator, double denominator)
    {
        if (denominator == 0) return "0.0%";
        return (numerator / denominator).ToString("0.0%");
    }

    string GetValueClass(decimal val)
    {
        if (val > 0) return "val-positive";
        if (val < 0) return "val-negative";
        return "val-neutral";
    }
}

@section css {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.12.1/css/dataTables.bootstrap4.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/fixedcolumns/4.1.0/css/fixedColumns.bootstrap4.min.css" />
    <style>
        .stats-table td,
        .stats-table th {
            white-space: nowrap;
        }

        .border-right-group {
            border-right: 3px solid var(--theme-border-medium) !important;
        }

        .nowrap-header {
            white-space: nowrap;
            text-align: center !important;
        }
    </style>
}

<div class="d-flex justify-content-between align-items-center flex-wrap mb-3">
    <div>
        @if (ViewBag.gameId == 0)
        {
            <h2 class="mb-1"><i class="fa-solid fa-chart-pie text-primary mr-2"></i>历史数据</h2>
            @if (!string.IsNullOrEmpty(ViewBag.message as string))
            {
                <p class="text-muted small mb-0"><i class="fa-solid fa-circle-info mr-1"></i>@ViewBag.message</p>
            }
        }
        else
        {
            <h2 class="mb-0"><i class="fa-solid fa-chart-simple text-primary mr-2"></i>本场数据</h2>
        }
    </div>
    @if (ViewBag.gameId != 0)
    {
        <a class="btn btn-outline-primary btn-sm mt-2 mt-sm-0" href="@Url.Action("Game", "Mahjong", new { gameId = (int)ViewBag.gameId })">
            <i class="fa-solid fa-arrow-left mr-1"></i>返回牌局
        </a>
    }
</div>

<!-- 总览数据 -->
<div class="card mb-4">
    <div class="card-header">
        <i class="fa-solid fa-table text-primary mr-2"></i>综合概览
    </div>
    <div class="card-body p-2">
        <table id="statsTable" class="table table-bordered table-hover table-sm stats-table">
            <thead class="thead-light">
                <tr>
                    <th rowspan="2" class="nowrap-header border-right-group">玩家</th>
                    <th rowspan="2" class="nowrap-header">盘数 (#)</th>
                    <th rowspan="2" class="nowrap-header">输赢 ($)</th>
                    <th rowspan="2" class="nowrap-header border-right-group">平均每局输赢 ($/#)</th>
                    <th colspan="3" class="nowrap-header border-right-group">胡牌</th>
                    <th colspan="3" class="nowrap-header border-right-group">输牌</th>
                    <th colspan="2" class="nowrap-header border-right-group">无关</th>
                    <th colspan="2" class="nowrap-header">荒庄</th>
                </tr>
                <tr>
                    <th class="nowrap-header">#</th>
                    <th class="nowrap-header">%</th>
                    <th class="nowrap-header border-right-group">$/#</th>
                    <th class="nowrap-header">#</th>
                    <th class="nowrap-header">%</th>
                    <th class="nowrap-header border-right-group">$/#</th>
                    <th class="nowrap-header">#</th>
                    <th class="nowrap-header border-right-group">%</th>
                    <th class="nowrap-header">#</th>
                    <th class="nowrap-header">%</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Player player in realPlayers)
                {
                    var stat = statBook[player.Id];
                    var net = stat.MoneyWon - stat.MoneyLost;
                    <tr class="text-right tabular-nums">
                        <td class="text-left font-weight-bold border-right-group">@player.Name</td>
                        <td>@stat.RoundsPlayed</td>
                        <td class="@GetValueClass(net)">@FmtMoney(net)</td>
                        <td class="border-right-group @GetValueClass(net)">@FmtAvg(net, stat.RoundsPlayed)</td>
                        <td>@stat.Wins</td>
                        <td>@FmtPct(stat.Wins, stat.RoundsPlayed)</td>
                        <td class="border-right-group">@FmtAvg(stat.MoneyWon, stat.Wins)</td>
                        <td>@stat.Loses</td>
                        <td>@FmtPct(stat.Loses, stat.RoundsPlayed)</td>
                        <td class="border-right-group">@FmtAvg(stat.MoneyLost, stat.Loses)</td>
                        <td>@stat.Push</td>
                        <td class="border-right-group">@FmtPct(stat.Push, stat.RoundsPlayed)</td>
                        <td>@stat.Huangfan</td>
                        <td>@FmtPct(stat.Huangfan, stat.RoundsPlayed)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

