            <i class="fa-solid fa-dice text-primary mr-2"></i>骰子数据
        </div>
        <div class="card-body p-2">
            <table id="diceTable" class="table table-bordered table-hover table-sm stats-table">
                <thead class="thead-light">
                    <tr>
                        <th class="nowrap-header">骰子</th>
                        @foreach (Player player in diceRollers)
                        {
                            if (playerTotalRolls.ContainsKey(player.Id))
                            {
                                <th class="nowrap-header">@player.Name</th>
                            }
                        }
                        <th class="nowrap-header">理论概率</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DiceRoll diceRoll in diceRolls)
                    {
                        <tr>
                            @{
                                var src1 = $"/Content/images/dice-0{diceRoll.dice.dice1}.png";
                                var src2 = $"/Content/images/dice-0{diceRoll.dice.dice2}.png";
                                double avg = diceRoll.dice.dice1 == diceRoll.dice.dice2 ? (double)1 / 36 : (double)1 / 18;
                                avg *= 100;
                            }
                            <td class="text-nowrap" style="padding: 2px 6px;">
                                <img src="@src1" class="dice" alt="@diceRoll.dice.dice1" /><img src="@src2" class="dice" alt="@diceRoll.dice.dice2" />
                            </td>
                            @foreach (Player player in diceRollers)
                            {
                                if (playerTotalRolls.ContainsKey(player.Id))
                                {
                                    int count = diceRoll.GetPlayerRollCount(player.Id);
                                    int total = playerTotalRolls[player.Id];
                                    double percentage = total > 0 ? (double)count / total * 100 : 0;
                                    int r = percentage > avg ? Math.Min(255, (int)((percentage / avg - 1) * 512)) : 0;
                                    int b = percentage < avg ? Math.Min(255, (int)((1 - percentage / avg) * 512)) : 0;
                                    int g = percentage > avg ? 255 - r : 255 - b;
                                    g = Math.Clamp(g, 0, 255);
                                    double diffPct = (percentage / avg - 1) * 100;
                                    string sign = diffPct > 0 ? "+" : "";
                                    <td class="dice-heat-cell" style="background-color:rgba(@r, @g, @b, 0.78)">
                                        @sign@diffPct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)% (@count / @total)
                                    </td>
                                }
                            }
                            <td class="dice-heat-cell" style="background-color:rgba(0, 220, 90, 0.78)">
                                @avg.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)%
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/highcharts@latest/highcharts.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/highcharts@latest/modules/sankey.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/highcharts@latest/modules/dependency-wheel.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/highcharts@latest/modules/exporting.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/highcharts@latest/modules/export-data.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/highcharts@latest/modules/accessibility.js"></script>
    <script src="~/Content/js/highcharts-helpers.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/1.12.1/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.12.1/js/dataTables.bootstrap4.min.js"></script>
    <script src="https://cdn.datatables.net/fixedcolumns/4.1.0/js/dataTables.fixedColumns.min.js"></script>
    <script>
        $(function () {
            var dtConfig = {
                scrollX: true,
                paging: false,
                searching: false,
                info: false,
                fixedColumns: true
            };

            $('#statsTable').DataTable(dtConfig);
            $('#winTable').DataTable(dtConfig);
            $('#loseTable').DataTable(dtConfig);
            $('#handTable').DataTable(dtConfig);
            if ($('#diceTable').length) {
                $('#diceTable').DataTable(dtConfig);
            }

            if ($('#chart').length) {
                var cashFlowData = parseChartData(@Html.Raw(cashFlowDataJson));
                registerThemedChart(Highcharts.chart('chart', Highcharts.merge(getMahjongChartTheme(), {
                    chart: {
                        zoomType: 'x'
                    },
                    title: {
                        text: ''
                    },
                    accessibility: {
                        point: {
                            valueDescriptionFormat: '{index}. From {point.from} to {point.to}: {point.weight}.'
                        }
                    },
                    tooltip: {
                        pointFormat: '{point.fromNode.name} &rarr; {point.toNode.name}: <b>${point.weight:,.2f}</b>',
                        nodeFormat: '{point.name}: <b>${point.sum:,.2f}</b>'
                    },
                    series: [{
                        keys: ['from', 'to', 'weight'],
                        type: 'dependencywheel',
                        name: 'Cash Flow',
                        data: cashFlowData,
                        dataLabels: {
                            color: (document.documentElement.getAttribute('data-theme') === 'dark') ? '#f8fafc' : '#0f172a',
                            textPath: {
                                enabled: true
                            },
                            distance: 10
                        }
                    }],
                    exporting: {
                        enabled: true
                    },
                    credits: {
                        enabled: false
                    }
                })));
            }
        });
    </script>
}
