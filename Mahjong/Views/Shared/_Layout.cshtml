@using System.Reflection
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isRecordsActive = currentController == "Mahjong" && (currentAction == "Records" || currentAction == "RoundRecords");
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-3HGH3YFG6R"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());
        gtag('set', {
            'page_title': @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Title?.ToString() ?? ""))
        });
        gtag('config', 'G-3HGH3YFG6R');
    </script>
    <!-- Initialize theme from localStorage or system preference before paint -->
    <script>
        (function () {
            try {
                var savedTheme = localStorage.getItem('theme');
                var systemDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                var theme = (savedTheme === 'dark' || savedTheme === 'light') ? savedTheme : (systemDark ? 'dark' : 'light');
                document.documentElement.setAttribute('data-theme', theme);
            } catch (e) { }
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - 上海麻将</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css" />
    <link rel="stylesheet" href="~/Content/css/Site.css" asp-append-version="true" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.1/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/Content/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("css", required: false)
    @await RenderSectionAsync("headScripts", required: false)
</head>

<body>
    <nav class="navbar fixed-top navbar-expand-lg navbar-light">
        <div class="container-fluid">
            <a class="navbar-brand" href="@Url.Action("Stats", "Mahjong", new { id = 0 })">
                <i class="fa-solid fa-dice"></i>上海麻将
            </a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav mr-auto">
                    @if (User.IsInRole("Administrator") || User.IsInRole("Mahjong"))
                    {
                        <li class="nav-item @(currentController == "Mahjong" && currentAction == "AddPlayer" ? "active" : "")">
                            <a class="nav-link" href="@Url.Action("AddPlayer", "Mahjong")">
                                <i class="fa-solid fa-user-plus mr-1 text-muted"></i>新建玩家
                            </a>
                        </li>
                        <li class="nav-item @(currentController == "Mahjong" && currentAction == "NewGame" ? "active" : "")">
                            <a class="nav-link" href="@Url.Action("NewGame", "Mahjong")">
                                <i class="fa-solid fa-circle-play mr-1 text-muted"></i>新开一局
                            </a>
                        </li>
                    }

                    <li class="nav-item @(currentController == "Mahjong" && currentAction == "History" ? "active" : "")">
                        <a class="nav-link" href="@Url.Action("History", "Mahjong")">
                            <i class="fa-solid fa-clock-rotate-left mr-1 text-muted"></i>历史战绩
                        </a>
                    </li>
                    <li class="nav-item @(currentController == "Mahjong" && currentAction == "LeaderBoard" ? "active" : "")">
                        <a class="nav-link" href="@Url.Action("LeaderBoard", "Mahjong")">
                            <i class="fa-solid fa-trophy mr-1 text-muted"></i>排行榜
                        </a>
                    </li>
                    <li class="nav-item @(currentController == "Mahjong" && currentAction == "Stats" ? "active" : "")">
                        <a class="nav-link" href="@Url.Action("Stats", "Mahjong", new { id = 0 })">
                            <i class="fa-solid fa-chart-pie mr-1 text-muted"></i>数据统计
                        </a>
                    </li>
                    <li class="nav-item dropdown @(isRecordsActive ? "active" : "")">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarRecordsDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fa-solid fa-medal mr-1 text-muted"></i>纪录
                        </a>
                        <div class="dropdown-menu shadow-sm" aria-labelledby="navbarRecordsDropdown">
                            <a class="dropdown-item @(currentAction == "Records" ? "active" : "")" href="@Url.Action("Records", "Mahjong")">
                                <i class="fa-solid fa-coins mr-2 text-muted"></i>输赢
                            </a>
                            <a class="dropdown-item @(currentAction == "RoundRecords" ? "active" : "")" href="@Url.Action("RoundRecords", "Mahjong")">
                                <i class="fa-solid fa-bolt mr-2 text-muted"></i>胜负
                            </a>
                        </div>
                    </li>
                    @if (User.IsInRole("Administrator"))
                    {
                        <li class="nav-item @(currentController == "Admin" ? "active" : "")">
                            <a class="nav-link" href="@Url.Action("Index", "Admin")">
                                <i class="fa-solid fa-shield-halved mr-1 text-muted"></i>系统设置
                            </a>
                        </li>
                    }
                </ul>

                <div class="d-flex align-items-center flex-wrap my-2 my-lg-0">
                    <button type="button" class="theme-toggle-btn mr-2" id="themeToggle" aria-label="切换浅色或深色主题" title="切换浅色 / 深色主题">
                        <i class="fa-solid fa-sun icon-sun" aria-hidden="true"></i>
                        <i class="fa-solid fa-moon icon-moon" aria-hidden="true"></i>
                        <span id="themeLabel">深色</span>
                    </button>
                    @await Html.PartialAsync("_LoginPartial")
                </div>
            </div>
        </div>
    </nav>

    <div class="container-fluid body-content d-flex flex-column">
        <div class="flex-grow-1">
            @RenderBody()
        </div>
        <hr class="mb-2 mt-4" />
        <footer class="pb-2">
            @{
                var informationalVersion = System.Reflection.Assembly.GetExecutingAssembly()
                    .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>()
                    ?.InformationalVersion ?? "Unknown|Unknown";

                var parts = informationalVersion.Split('|');
                var version = parts.Length > 0 ? parts[0] : "Unknown";
                var date = parts.Length > 1 ? parts[1] : "Unknown";
            }
            <div class="d-flex justify-content-between align-items-center flex-wrap small text-muted">
                <div>
                    &copy; @DateTime.Now.Year - Jay Tang &bull; 上海麻将
                </div>
                <div>
                    Version: <span class="font-weight-bold text-dark">@version</span> | Built: <span>@date</span>
                </div>
            </div>
        </footer>
    </div>

    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
