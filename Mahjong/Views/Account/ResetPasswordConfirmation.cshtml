@{
    ViewBag.Title = "密码已重置";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card border-left-success text-center p-4">
                <div class="mb-3 text-success">
                    <i class="fa-solid fa-circle-check fa-3x"></i>
                </div>
                <h3 class="mb-2">密码已重置</h3>
                <p class="text-muted mb-3">您的密码已成功更新。</p>
                <div>
                    <a class="btn btn-primary" href="@Url.Action("Login", "Account")" id="loginLink">前往登录</a>
                </div>
            </div>
        </div>
    </div>
</div>
