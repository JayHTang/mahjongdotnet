@{
    ViewBag.Title = "邮箱确认";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card border-left-success text-center p-4">
                <div class="mb-3 text-success">
                    <i class="fa-solid fa-envelope-circle-check fa-3x"></i>
                </div>
                <h3 class="mb-2">邮箱验证成功</h3>
                <p class="text-muted mb-3">感谢确认您的邮箱。</p>
                <div>
                    <a class="btn btn-primary" href="@Url.Action("Login", "Account")" id="loginLink">点击登录</a>
                </div>
            </div>
        </div>
    </div>
</div>
