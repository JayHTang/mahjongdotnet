@model Mahjong.Models.SendCodeViewModel
@{
    ViewBag.Title = "发送验证码";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card border-left-primary">
                <div class="card-header">
                    <i class="fa-solid fa-shield-halved text-primary mr-2"></i>双重验证
                </div>
                <div class="card-body p-4">
                    @using (Html.BeginForm("SendCode", "Account", new { ReturnUrl = Model.ReturnUrl }, FormMethod.Post, antiforgery: null, htmlAttributes: new { role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.Hidden("rememberMe", Model.RememberMe)
                        <div class="form-group">
                            <label class="font-weight-bold small text-secondary">选择验证方式</label>
                            @Html.DropDownListFor(model => model.SelectedProvider, Model.Providers, new { @class = "custom-select" })
                        </div>
                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-primary">发送验证码</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.4/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
}
