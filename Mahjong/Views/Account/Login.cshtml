@using Mahjong.Models
@model LoginViewModel
@{
    ViewBag.Title = "登录";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-sm-10 col-md-7 col-lg-5 col-xl-4">
            <div class="card border-left-primary">
                <div class="card-body p-4">
                    <div class="text-center mb-4">
                        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-light border mb-2" style="width: 52px; height: 52px;">
                            <i class="fa-solid fa-dice fa-lg text-primary"></i>
                        </div>
                        <h3 class="mb-1">上海麻将</h3>
                        <p class="text-muted small mb-0">使用账号登录以记录与管理牌局</p>
                    </div>

                    <section id="loginForm">
                        @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, antiforgery: null, htmlAttributes: new { role = "form" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger small mb-3" })

                            <div class="form-group">
                                @Html.LabelFor(m => m.UserName, "用户名", new { @class = "font-weight-bold small text-secondary" })
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fa-regular fa-user"></i></span>
                                    </div>
                                    @Html.TextBoxFor(m => m.UserName, new { @class = "form-control", placeholder = "请输入用户名", autocomplete = "username" })
                                </div>
                                @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group">
                                @Html.LabelFor(m => m.Password, "密码", new { @class = "font-weight-bold small text-secondary" })
                                <div class="input-group">
                                    <div class="input-group-prepend">
                                        <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                                    </div>
                                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "请输入密码", autocomplete = "current-password" })
                                </div>
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group d-flex align-items-center mb-4">
                                <label class="mb-0 d-inline-flex align-items-center small text-secondary" style="cursor: pointer;">
                                    @Html.CheckBoxFor(m => m.RememberMe)
                                    <span>记住登录状态</span>
                                </label>
                            </div>

                            <button type="submit" class="btn btn-primary btn-block">
                                <i class="fa-solid fa-arrow-right-to-bracket mr-1"></i>登录
                            </button>
                        }
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.4/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
}
